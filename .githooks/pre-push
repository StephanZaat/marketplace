#!/usr/bin/env bash
# All checks run here, not on GitHub: the deploy workflow only deploys (like BTM).
set -euo pipefail

# Always use the main project's containers regardless of worktree
export COMPOSE_PROJECT_NAME=marketplace

echo "=== Pre-push: TypeScript type check ==="
docker compose exec -T frontend ./node_modules/.bin/tsc --noEmit

echo "=== Pre-push: Frontend tests ==="
docker compose exec -T frontend ./node_modules/.bin/vitest run

echo "=== Pre-push: Backend tests (Postgres 18) ==="
docker compose --profile test run --rm -T test

echo "=== All checks passed ==="
